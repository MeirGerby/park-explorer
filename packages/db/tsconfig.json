{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Node16",
    "moduleResolution": "Node16",

    "declaration": true,
    "emitDeclarationOnly": false,

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "outDir": "./dist",
    "rootDir": "./src",

    "noEmit": false,
    "sourceMap": true,

    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}