# Builds apps/web as a static bundle and serves it with nginx.
#
# VITE_API_URL is baked in at build time (Vite env vars are compile-time, not
# runtime). It defaults to a relative "/trpc" so the browser calls the same
# origin nginx is served from; nginx then reverse-proxies /trpc to the api
# service internally, which avoids CORS and cross-port cookie issues.

FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.23.0 --activate

# apps/web depends on api's *compiled* @generated/server.d.ts for the
# AppRouter type (apps/web/package.json declares "api" as a devDependency
# so turbo's "^build" builds api, then @park-explorer/db, before web).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web apps/web
COPY apps/api apps/api
COPY packages/db packages/db

RUN pnpm install --frozen-lockfile

ARG VITE_API_URL=/trpc
ENV VITE_API_URL=$VITE_API_URL
ENV TURBO_TELEMETRY_DISABLED=1
RUN pnpm turbo run build --filter=web...

# nginx-unprivileged (not the plain nginx image) so this runs correctly under
# an arbitrary non-root UID with no privileged port — required by OpenShift's
# restricted SCC, and harmless everywhere else (Docker Compose included).
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY nginx.web.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
