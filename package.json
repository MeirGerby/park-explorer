{
  "name": "park-explorer",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "dependencies": {
    "drizzle-orm": "0.38.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.7.4",
    "tsx": "^4.23.12",
    "turbo": "^2.10.9",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
